# Moteur IA (Gemini) — variables lues côté SERVEUR uniquement.
# En local : copiez ce fichier vers .env.local (ignoré par Git) et renseignez la clé.
# En production : définissez-les dans Vercel → Settings → Environment Variables.
# Ne préfixez JAMAIS la clé par VITE_ : elle serait intégrée au JavaScript du site.
GEMINI_API_KEY=
# Facultatif (défaut : gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Facultatif : autres domaines autorisés à appeler /api/gemini, séparés par des virgules.
# Le domaine du site lui-même est toujours autorisé.
ALLOWED_ORIGINS=
